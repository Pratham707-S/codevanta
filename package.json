{
  "name": "repoguard-agent",
  "version": "0.1.2",
  "description": "CLI-first AI software reliability tool providing safe, evidence-backed repository inspection, AI-assisted investigation, reviewable repairs, and controlled verification.",
  "type": "module",
  "bin": {
    "repoguard": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "code-analysis",
    "code-review",
    "security",
    "verification",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pratham707-S/repoguard.git"
  },
  "bugs": {
    "url": "https://github.com/Pratham707-S/repoguard/issues"
  },
  "homepage": "https://github.com/Pratham707-S/repoguard#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "eslint": "^9.21.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "8.71.1",
    "vitest": "^3.0.7"
  }
}
