{
  "version": "1.0.0",
  "project": {
    "name": "my-service",
    "exclude": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "coverage/**"
    ]
  },
  "scan": {
    "maxFileSize": 1048576,
    "redactSecrets": true
  },
  "verification": {
    "timeoutMs": 30000,
    "allowedCommands": [
      "npm test",
      "npm run lint"
    ]
  },
  "ai": {
    "provider": "gemini",
    "model": "gemini-2.5-pro",
    "multiPass": true
  }
}
